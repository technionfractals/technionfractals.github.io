---
import BaseLayout from "../layouts/BaseLayout.astro";
import site from "../data/site.json";

interface Participant {
  name: string;
  url?: string;
  email?: string;
  showEmail?: boolean;
}

const familyName = (name: string) => name.trim().split(/\s+/).at(-1) ?? name;
const participants = [...site.about.participants as Participant[]].sort((a, b) => familyName(a.name).localeCompare(familyName(b.name)));
---

<BaseLayout title="Welcome!" description={site.about.description} current="about">
  <header class="page-header">
    <h1>Welcome!</h1>
    <p>{site.about.description}</p>
  </header>

  <section class="content-grid about-grid">
    <div>
      <h2>Regular participants</h2>
      <ul class="plain-list participant-list">
        {participants.map((participant) => (
          <li>
            {participant.url ? (
              <a href={participant.url} target="_blank" rel="noopener noreferrer">{participant.name}</a>
            ) : participant.name}
            {participant.showEmail && participant.email && (
              <span class="participant-email"> · {participant.email}</span>
            )}
          </li>
        ))}
      </ul>
      <p class="participant-note">Fictional names for web testing</p>
    </div>
  </section>

  <section class="contact-block">
    <h2>Contact</h2>
    <ul class="plain-list contact-list">
      {site.about.contacts.map((contact) => (
        <li><strong>{contact.label}:</strong> {contact.value}</li>
      ))}
    </ul>
  </section>
</BaseLayout>
