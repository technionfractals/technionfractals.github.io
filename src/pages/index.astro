---
import BaseLayout from "../layouts/BaseLayout.astro";
import PaginatedTalkList from "../components/PaginatedTalkList.astro";
import { getCollection } from "astro:content";
import { compareTalksSoonestFirst, getTalkDay } from "../lib/talks";
import site from "../data/site.json";

const talks = (await getCollection("talks", ({ data }) => data.status === "published"))
  .sort(compareTalksSoonestFirst);
const today = new Intl.DateTimeFormat("en-CA", {
  year: "numeric", month: "2-digit", day: "2-digit", timeZone: "Asia/Jerusalem",
}).format(new Date());
const upcoming = talks.filter((talk) => getTalkDay(talk.data.date) >= today);
---

<BaseLayout title="Upcoming talks" current="upcoming">
  <header class="page-header">
    <h1>Upcoming talks</h1>
    <p>{site.upcoming.description}</p>
  </header>
  <PaginatedTalkList talks={upcoming} emptyMessage="No upcoming talks have been announced." />
</BaseLayout>
