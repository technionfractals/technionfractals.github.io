---
import "katex/dist/katex.min.css";
import "../styles/global.css";
import site from "../data/site.json";
import { formatTalkDate } from "../lib/talks";

interface Props {
  title?: string;
  description?: string;
  current?: "upcoming" | "previous" | "submit" | "about";
  socialImage?: boolean;
}

const {
  title = site.general.title,
  description = site.upcoming.description,
  current,
  socialImage = true,
} = Astro.props;

const pageTitle = title === site.general.title ? title : `${title} · ${site.general.title}`;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site);
const socialImageUrl = new URL("/og-card.png", Astro.site);
const lastUpdated = formatTalkDate(new Date());
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#002147" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalUrl} />
    {socialImage && <meta property="og:image" content={socialImageUrl} />}
    <meta name="twitter:card" content={socialImage ? "summary_large_image" : "summary"} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href="/favicon.svg?v=2" type="image/svg+xml" sizes="any" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <header class="site-header">
      <nav class="nav" aria-label="Main navigation">
        <a class="brand" href="/">
          <span>{site.general.title}</span>
        </a>
        <button
          class="nav-toggle"
          type="button"
          aria-expanded="false"
          aria-controls="primary-navigation"
          aria-label="Open navigation"
        >
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
          <span aria-hidden="true"></span>
        </button>
        <div class="nav-links" id="primary-navigation" data-open="false">
          <a href="/" aria-current={current === "upcoming" ? "page" : undefined}>Upcoming</a>
          <a href="/previous/" aria-current={current === "previous" ? "page" : undefined}>Previous</a>
          <a href="/submit/" aria-current={current === "submit" ? "page" : undefined}>Submit</a>
          <a href="/about/" aria-current={current === "about" ? "page" : undefined}>About</a>
        </div>
      </nav>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner">
        <span>Last updated: {lastUpdated}</span>
        <a
          class="footer-license"
          href="https://creativecommons.org/licenses/by-nc/4.0/"
          target="_blank"
          rel="license noopener noreferrer"
        >CC BY-NC 4.0</a>
      </div>
    </footer>
    <script>
      const navigation = document.querySelector<HTMLElement>(".nav");
      const toggle = navigation?.querySelector<HTMLButtonElement>(".nav-toggle");
      const links = navigation?.querySelector<HTMLElement>(".nav-links");

      const setNavigationOpen = (open: boolean) => {
        if (!toggle || !links) return;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", open ? "Close navigation" : "Open navigation");
        links.dataset.open = String(open);
      };

      toggle?.addEventListener("click", () => {
        setNavigationOpen(toggle.getAttribute("aria-expanded") !== "true");
      });

      links?.querySelectorAll("a").forEach((link) => {
        link.addEventListener("click", () => setNavigationOpen(false));
      });

      document.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && toggle?.getAttribute("aria-expanded") === "true") {
          setNavigationOpen(false);
          toggle.focus();
        }
      });
    </script>
  </body>
</html>
